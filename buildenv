zopen_check_results() {
  dir="$1"
  pfx="$2"
  chk="$1/$2_check.log"
  # testapp emits TAP. Its plan is the expected native test count; count TAP
  # failures independently so a partial or failed run cannot be reported as a
  # successful check.
  total_tests=$(awk '/^1\.\.[0-9]+$/ { sub(/^1\.\./, ""); total = $0 } END { print total + 0 }' "$chk")
  actual_failures=$(awk '/^not ok [0-9]+/ { failures++ } END { print failures + 0 }' "$chk")

  echo "actualFailures:${actual_failures}"
  echo "totalTests:${total_tests}"
  echo "expectedFailures:0"
  echo "expectedTotalTests:${total_tests}"
}

zopen_get_version() {
  echo "$MEMCACHED_VERSION"
}


